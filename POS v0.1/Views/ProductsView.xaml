<UserControl x:Class="POS_v0_1.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000" Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="White" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Inventario de Productos" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title and Main Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Inventario de Productos" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⚠ Alertas de Stock" Background="#ffc107" Foreground="Black" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"
                        Command="{Binding StockAlertCommand}">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="+ Nuevo Producto" Background="#007bff" Foreground="White" Padding="15,8" BorderThickness="0"
                        Command="{Binding ShowCreateProductCommand}">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar nombre, código..." Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5"/>

                <ComboBox Width="150" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          Margin="0,0,10,0" VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <TextBlock x:Key="Placeholder" Text="Categorías" Foreground="Gray"/>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBox Width="200" Text="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged}" Tag="Ubicación (Ej: Vitrina 1)" Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="5"/>

                <ComboBox Width="120" SelectedValue="{Binding StatusFilter}" SelectedValuePath="Content" Margin="0,0,10,0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Estados"/>
                    <ComboBoxItem Content="Activo"/>
                    <ComboBoxItem Content="Inactivo"/>
                </ComboBox>

                <Button Content="🔍 Filtrar" Command="{Binding FilterCommand}" Background="#6c757d" Foreground="White" Padding="20,5" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Data Table -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredProducts}" AutoGenerateColumns="False"
                  Background="Transparent" BorderThickness="0" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="60">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#EEEEEE"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Imagen" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="40" Height="40" Background="#f0f0f0" CornerRadius="5" Margin="5"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Nombre / Código" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Barcode}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="150"/>

                <DataGridTemplateColumn Header="Precios (Compra/Venta)" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PurchasePrice, StringFormat='C: {0:C}'}" Foreground="#dc3545" FontSize="11"/>
                                <TextBlock Text="{Binding SellingPrice, StringFormat='V: {0:C}'}" FontWeight="Bold" Foreground="#28a745"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Stock / Ubicación" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Location}" Foreground="Gray" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Estado" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#d4edda" CornerRadius="5" Padding="5,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Status}" Foreground="#155724" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="👁" Margin="2" Padding="8,4" Background="White" BorderBrush="#0dcaf0" Foreground="#0dcaf0"
                                        Command="{Binding DataContext.ShowProductDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="✎" Margin="2" Padding="8,4" Background="White" BorderBrush="#007bff" Foreground="#007bff"
                                        Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="🗑" Margin="2" Padding="8,4" Background="White" BorderBrush="#dc3545" Foreground="#dc3545"
                                        Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
