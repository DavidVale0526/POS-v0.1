<UserControl x:Class="POS_v0_1.Views.RepairTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Tipos de Reparación" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="150" SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form: Nuevo Tipo -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipos de Reparación" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⊕ NUEVO TIPO" Foreground="#6c757d" Margin="0,0,0,15" FontSize="12"/>

                        <TextBlock Text="Categoría Padre" Margin="0,0,0,5"/>
                        <ComboBox Margin="0,0,0,15" Padding="8"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="8"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <TextBlock Text="Nombre" Margin="0,0,0,5"/>
                        <TextBox Margin="0,0,0,15" Padding="8" Tag="Ej: Cambio de pantalla AMOLED..."
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Precio Base (C$)" Margin="0,0,0,5"/>
                        <TextBox Margin="0,0,0,15" Padding="8"
                                 Text="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Descripción" Margin="0,0,0,5"/>
                        <TextBox Margin="0,0,0,20" Padding="8" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Guardar" Background="#0d6efd" Foreground="White" Padding="15,10"
                                FontWeight="Bold" BorderThickness="0" Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Table Section -->
            <StackPanel Grid.Column="2">
                <Button Content="← Volver a Reparaciones" HorizontalAlignment="Right" Padding="15,5"
                        Background="White" BorderBrush="#ced4da" Command="{Binding BackCommand}" Margin="0,0,0,20"/>

                <Border Background="White" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#f8f9fa" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tipo" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Categoría" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Precio Base" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Descripción" FontWeight="Bold" Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="Acciones" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Items -->
                        <ItemsControl ItemsSource="{Binding Types}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding BasePrice, StringFormat='C$ \{0:N2\}'}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Description}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Background="Transparent" BorderThickness="0" Margin="0,0,5,0"/>
                                                <Button Content="🗑️" Background="Transparent" BorderThickness="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Grid Margin="40" Visibility="{Binding Types.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No se han registrado tipos de reparación." HorizontalAlignment="Center" Foreground="#adb5bd"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
