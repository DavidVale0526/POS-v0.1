<Window x:Class="POS_v0_1.Views.ManageTopupCompaniesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Recargas" Height="700" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/> <!-- Spacer -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sección de Compañías -->
        <TextBlock Text="1. Compañías Telefónicas" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5">
            <ListBox ItemsSource="{Binding TopupCompanies}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Color}" CornerRadius="10" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14"/>
                                <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                        FontWeight="Bold" Padding="10,5" Cursor="Hand"
                                        Click="Delete_Click" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewCompanyName" Margin="0,0,10,0" Padding="8" Tag="Nombre de la empresa (Ej: DIGICEL)"/>
                <ComboBox x:Name="ColorPicker" Grid.Column="1" Margin="0,0,10,0" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Azul" Tag="#0033A0"/>
                    <ComboBoxItem Content="Rojo" Tag="#EF3340"/>
                    <ComboBoxItem Content="Verde" Tag="#198754"/>
                    <ComboBoxItem Content="Naranja" Tag="#F59E0B"/>
                    <ComboBoxItem Content="Púrpura" Tag="#7C3AED"/>
                </ComboBox>
                <Button Grid.Column="2" Content="+ Agregar Empresa" Padding="15,8" Background="#0d6efd" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Add_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Sección de Presets -->
        <TextBlock Grid.Row="4" Text="2. Montos Rápidos (Presets)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,10,0,10"/>

        <Border Grid.Row="5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5">
            <ListBox ItemsSource="{Binding TopupPresets}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompanyName}" FontWeight="Bold" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Cost, StringFormat='Costo: C$ \{0:N2\}'}" VerticalAlignment="Center" Margin="20,0" Foreground="#10B981" FontWeight="Medium"/>
                                <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                        FontWeight="Bold" Padding="10,5" Cursor="Hand"
                                        Click="DeletePreset_Click" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock Text="Agregar nuevo monto predeterminado:" FontSize="12" Foreground="#64748B" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PresetCompanyCombo" ItemsSource="{Binding TopupCompanies}" DisplayMemberPath="Name" Margin="0,0,5,0" Padding="8" VerticalContentAlignment="Center"/>
                <TextBox x:Name="PresetAmount" Grid.Column="1" Margin="0,0,5,0" Tag="Venta C$" Padding="8" HorizontalContentAlignment="Center"/>
                <TextBox x:Name="PresetCost" Grid.Column="2" Margin="0,0,5,0" Tag="Costo C$" Padding="8" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="3" Content="+ Agregar Monto" Padding="15,8" Background="#198754" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="AddPreset_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
