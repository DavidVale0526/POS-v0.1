<UserControl x:Class="POS_v0_1.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:POS_v0_1.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Punto de Venta (POS)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SellerNamePreview}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Products -->
            <DockPanel Grid.Column="0" Margin="0,0,15,0">
                <Border DockPanel.Dock="Top" Background="White" CornerRadius="5" BorderBrush="#dee2e6" BorderThickness="1" Margin="0,0,0,15">
                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#adb5bd"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" VerticalContentAlignment="Center" FontSize="14"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Background="White" BorderBrush="#dee2e6" BorderThickness="1"
                                        Width="160" Height="150" Margin="0,0,10,10" Padding="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Item" FontSize="20" HorizontalAlignment="Center" Foreground="#adb5bd" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="40"/>
                                        <TextBlock Text="{Binding SellingPrice, StringFormat={}{0:C}}" Foreground="#28a745" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16" Margin="0,5"/>
                                        <TextBlock Text="{Binding Stock, StringFormat={}Stock: {0}}" FontSize="11" Foreground="#dc3545" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- RIGHT: Cart -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#EEEEEE"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hidden textbox to receive input from keyboard-style barcode scanners. It is focused on load. -->
                    <TextBox x:Name="BarcodeInput" Width="1" Height="1" Opacity="0" VerticalAlignment="Top"
                             KeyDown="BarcodeInput_KeyDown" />

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Venta Actual" FontSize="18" FontWeight="SemiBold"/>
                        <Button Content="Vaciar" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Padding="10,2" Background="White" BorderBrush="#dc3545" Foreground="#dc3545"
                                Command="{Binding ClearCartCommand}"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox SelectedIndex="0" Padding="10,5">
                            <ComboBoxItem Content="Consumidor Final"/>
                        </ComboBox>
                        <Button Grid.Column="1" Content="+" Margin="5,0,0,0" Padding="10,0"/>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="3" Margin="0,0,0,15" Padding="5">
                        <StackPanel>
                            <TextBlock Text="PIN Vendedor:" FontSize="10" Foreground="Gray" Margin="2,0,0,0"/>
                            <TextBox BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" FontWeight="Bold"
                                     Text="{Binding SellerPin, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding SellerNamePreview, StringFormat='Vendedor: {0}'}"
                                       FontSize="12" Foreground="#007bff" FontWeight="SemiBold" Margin="2,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#eee" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Product.Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Product.SellingPrice, StringFormat={}{0:C}}"
                                                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0">
                                                    <Button Content="-" Width="25" Height="25"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Border BorderBrush="#dee2e6" BorderThickness="1,0" Width="30">
                                                        <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Content="+" Width="25" Height="25"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat={}{0:N2}}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="0,15,0,0">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Subtotal:" Foreground="Gray"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Descuento:" Foreground="Gray"/>
                            <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="60" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="IVA:" Foreground="Gray"/>
                            <TextBlock Text="{Binding Iva, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,10">
                            <TextBlock Text="TOTAL:" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="#28a745" HorizontalAlignment="Right"/>
                        </Grid>
                        <Button Content="Cobrar (F8)" Height="50" Background="#007bff" Foreground="White" FontSize="16" FontWeight="Bold"
                                Command="{Binding SellCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
