<UserControl x:Class="POS_v0_1.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000" Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="White" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Detalle del Producto" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Detalle del Producto" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← Volver" Padding="15,8" Background="White" BorderBrush="#ced4da" BorderThickness="1"
                        Command="{Binding BackCommand}" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="✎ Editar" Padding="15,8" Background="#007bff" Foreground="White" BorderThickness="0"
                        Command="{Binding EditCommand}">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Image and Status -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="200" Height="200" Background="#f8f9fa" CornerRadius="5" Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="📷" FontSize="64" Foreground="#dee2e6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Product.ImagePath, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}"/>
                                <Image Source="{Binding Product.ImagePath}" Stretch="UniformToFill"
                                       Visibility="{Binding Product.ImagePath, Converter={StaticResource VisConverter}}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Product.Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Border Background="#198754" CornerRadius="15" Padding="20,5" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Product.Status}" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding Product.Description, TargetNullValue='Sin descripción'}" TextWrapping="Wrap" TextAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="INFORMACIÓN GENERAL" FontWeight="Bold" Foreground="Gray" Margin="0,20,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Categoría:" Margin="0,0,0,10" Foreground="Gray"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Product.CategoryName}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Proveedor:" Margin="0,0,0,10" Foreground="Gray"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Product.ProviderName, TargetNullValue='N/A'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cod. Barras:" Margin="0,0,0,10" Foreground="Gray"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Product.Barcode, TargetNullValue='N/A'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SKU:" Margin="0,0,0,10" Foreground="Gray"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Product.SKU, TargetNullValue='N/A'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ubicación:" Margin="0,0,0,10" Foreground="Gray"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Product.Location, TargetNullValue='Sin asignar'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right Column: Prices, Stock and IMEIs -->
            <StackPanel Grid.Column="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,20">
                        <StackPanel>
                            <TextBlock Text="PRECIOS Y RENTABILIDAD" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>
                            <Grid>
                                <TextBlock Text="Costo de Compra:" Foreground="Gray"/>
                                <TextBlock Text="{Binding Product.PurchasePrice, StringFormat='C$ {0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Precio de Venta:" Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Product.SellingPrice, StringFormat='C$ {0:N2}'}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#198754"/>
                            </Grid>

                            <Separator Margin="0,15" Background="#f1f3f5"/>

                            <!-- Margen de Ganancia -->
                            <Grid>
                                <TextBlock Text="Margen de Ganancia:" Foreground="Gray"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MarginPercentage, StringFormat='\{0:N1\}%'}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#198754"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMarginNegative}" Value="True">
                                                        <Setter Property="Foreground" Value="#dc3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MarginAmount, StringFormat=' (C$ \{0:N2\})'}" FontSize="11" VerticalAlignment="Bottom" Margin="5,0,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6c757d"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMarginNegative}" Value="True">
                                                        <Setter Property="Foreground" Value="#dc3545"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Alerta de Pérdida -->
                            <Border Background="#f8d7da" CornerRadius="4" Padding="10,5" Margin="0,10,0,0"
                                    Visibility="{Binding IsMarginNegative, Converter={StaticResource VisConverter}}">
                                <TextBlock Text="⚠️ EL COSTO SUPERA AL PRECIO DE VENTA" FontSize="10" FontWeight="Bold" Foreground="#721c24" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#f8d7da" CornerRadius="8" Padding="20" Margin="10,0,0,20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="STOCK ACTUAL" FontWeight="Bold" Foreground="#721c24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Product.Stock}" FontSize="48" FontWeight="Bold" Foreground="#721c24" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Product.MinStock, StringFormat='Mínimo: {0}'}" Foreground="#721c24" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⚙ GESTIÓN DE IMEIS (UNIDADES ÚNICAS)" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>

                        <TextBlock Text="Registra los IMEIs para tener trazabilidad exacta de qué unidad se vende." FontSize="10" Foreground="#666" Margin="0,-10,0,15"/>

                        <!-- Add Imei -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Tag="Escanear o escribir nuevo IMEI..." Padding="10" Text="{Binding NewImei, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddImeiCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="+ Agregar" Background="#007bff" Foreground="White" Padding="20,0" Margin="10,0,0,0" BorderThickness="0"
                                    Command="{Binding AddImeiCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="Disponibles" Padding="15,5">
                                <ScrollViewer MaxHeight="250" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding AvailableImeis}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" Padding="5">
                                                    <Grid>
                                                        <TextBlock Text="{Binding ImeiNumber}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#dc3545"
                                                                Command="{Binding DataContext.DeleteImeiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Vendidos" Padding="15,5">
                                <ScrollViewer MaxHeight="250" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding SoldImeis}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" Padding="5">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ImeiNumber}" Foreground="#6c757d" TextDecorations="Strikethrough" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding SaleDate, StringFormat='(Vendido: \{0:dd/MM/yy\})'}" FontSize="10" Foreground="#198754" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SaleId, StringFormat='Ticket #\{0:D5\}'}" HorizontalAlignment="Right" FontSize="10" Foreground="#0d6efd" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <Grid Margin="0,20" Visibility="{Binding AvailableImeis.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No hay IMEIs disponibles." HorizontalAlignment="Center" Foreground="#adb5bd"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="📋 HISTORIAL DE COSTOS (ÚLTIMAS COMPRAS)" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,15"/>

                        <Border Background="#f8f9fa" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fecha" FontWeight="SemiBold" Foreground="#666"/>
                                <TextBlock Grid.Column="1" Text="Factura" FontWeight="SemiBold" Foreground="#666"/>
                                <TextBlock Grid.Column="2" Text="Proveedor" FontWeight="SemiBold" Foreground="#666"/>
                                <TextBlock Grid.Column="3" Text="Cant." FontWeight="SemiBold" Foreground="#666" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Costo" FontWeight="SemiBold" Foreground="#666" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PurchaseHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date, StringFormat='\{0:dd/MM/yy\}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Invoice}" Foreground="#666" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Provider}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Cost, StringFormat='C$ \{0:N2\}'}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,20" Visibility="{Binding PurchaseHistory.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No hay compras registradas para este producto." HorizontalAlignment="Center" Foreground="#adb5bd" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
