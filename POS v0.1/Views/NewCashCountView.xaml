<UserControl x:Class="POS_v0_1.Views.NewCashCountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Nuevo Conteo de Efectivo" FontSize="20" FontWeight="Bold"/>
                <Button Content="← Volver" HorizontalAlignment="Right" Padding="15,5"
                        Command="{Binding BackCommand}" Background="White" BorderBrush="#ced4da"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Margin="30,10" MaxWidth="600" HorizontalAlignment="Center"
                    BorderBrush="#dee2e6" BorderThickness="1" Padding="30">
                <StackPanel>
                    <TextBlock Text="Realizar Conteo de Efectivo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,25"/>

                    <!-- Calculator Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Denominación" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Subtotal" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Margin="0,0,0,10"/>

                    <!-- Denominations List -->
                    <ItemsControl ItemsSource="{Binding Denominations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#f8f9fa" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="5" TextAlignment="Center" VerticalContentAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='C$ \{0:N2\}'}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,20,0,20"/>

                    <!-- Resumen de Cierre -->
                    <TextBlock Text="RESUMEN DE CIERRE" FontWeight="Bold" Foreground="#666" Margin="0,0,0,10"/>

                    <Border Background="White" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Efectivo Físico Contado (C$)" Foreground="#333" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="5" Padding="15,10" Margin="0,0,0,15">
                                <TextBlock Text="{Binding TotalCalculated, StringFormat='N2'}" FontSize="28" FontWeight="Bold" Foreground="#198754" HorizontalAlignment="Right"/>
                            </Border>
                            <TextBlock Text="Este valor se calcula automáticamente con el conteo de billetes." FontSize="10" Foreground="Gray" Margin="0,-10,0,15"/>

                            <Border Background="#f8f9fa" CornerRadius="5" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Saldo Teórico en Sistema:" Foreground="#333" FontSize="14"/>
                                        <TextBlock Text="{Binding TheoreticalBalance, StringFormat='C$ \{0:N2\}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Diferencia (Sobrante/Faltante):" Foreground="#333" FontSize="14"/>
                                        <TextBlock Text="{Binding Difference, StringFormat='\{0:N2\}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"
                                                   Foreground="{Binding Difference, Converter={StaticResource DifferenceToBrushConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="Observaciones" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Tag="Explicación si hay diferencia..." Margin="0,0,0,30"/>

                    <!-- Action Button -->
                    <Button Content="💾 Guardar Conteo" Background="#0d6efd" Foreground="White" Padding="30,12"
                            FontWeight="Bold" HorizontalAlignment="Stretch" BorderThickness="0"
                            Command="{Binding SaveCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
