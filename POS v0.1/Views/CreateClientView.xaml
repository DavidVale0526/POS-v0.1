<UserControl x:Class="POS_v0_1.Views.CreateClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Nuevo Cliente" FontSize="20" FontWeight="Bold"/>
                <Button Content="← Volver" HorizontalAlignment="Right" Padding="15,5"
                        Command="{Binding BackCommand}" Background="White" BorderBrush="#ced4da"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Margin="30,10" MaxWidth="600" HorizontalAlignment="Center"
                    BorderBrush="#dee2e6" BorderThickness="1" Padding="30">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="Nombre del Cliente *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" FontSize="14" Margin="0,0,0,20"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Phone and Email Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Correo Electrónico" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Dirección Física" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                    <!-- Notes -->
                    <TextBlock Text="Notas Adicionales" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>

                    <!-- Action Button -->
                    <Button Content="💾 Guardar Cliente" Background="#0d6efd" Foreground="White" Padding="30,12"
                            FontWeight="Bold" HorizontalAlignment="Stretch" BorderThickness="0"
                            Command="{Binding SaveCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
