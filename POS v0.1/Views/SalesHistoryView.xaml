<UserControl x:Class="POS_v0_1.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Historial de Ventas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Title and New Sale Button -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Historial de Ventas" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <Button Content="🛒 Nueva Venta (POS)" HorizontalAlignment="Right"
                            Background="#007bff" Foreground="White" Padding="15,8"
                            BorderThickness="0" FontWeight="SemiBold"
                            Command="{Binding ShowPosCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Summary Cards -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <Border Background="#0d6efd" Width="200" Height="80" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VENDIDO" Foreground="White" FontSize="12" Opacity="0.8"/>
                            <TextBlock FontWeight="Bold" FontSize="18" Foreground="White">
                                <Run Text="C$ " /><Run Text="{Binding TotalSold, Mode=OneWay, StringFormat=\{0:N2\}}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="#0dcaf0" Width="200" Height="80" CornerRadius="8" Padding="15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TRANSACCIONES" Foreground="White" FontSize="12" Opacity="0.8"/>
                            <TextBlock Text="{Binding TransactionCount, Mode=OneWay}" FontWeight="Bold" FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Filters -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#dee2e6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0" Padding="10,8"
                                 Tag="Buscar por Ticket o Cliente..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#dee2e6"/>

                        <DatePicker Grid.Column="1" Margin="0,0,10,0" Padding="5"
                                    SelectedDate="{Binding SelectedDate}"
                                    VerticalContentAlignment="Center" BorderBrush="#dee2e6"/>

                        <ComboBox Grid.Column="2" Margin="0,0,10,0"
                                  ItemsSource="{Binding Sellers}"
                                  SelectedItem="{Binding SelectedSeller}"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#dee2e6">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <Trigger Property="SelectedItem" Value="{x:Null}">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="10,5"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <TextBlock IsHitTestVisible="False" Text="Vendedor..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#adb5bd">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ToggleButton x:Name="toggleButton" BorderThickness="0" Background="Transparent" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Fill="#6c757d" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" PopupAnimation="Slide" Placement="Bottom">
                                            <Border x:Name="dropDownBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="White" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=border}">
                                                <ScrollViewer x:Name="DropDownScrollViewer">
                                                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="false">
                                            <Setter Property="Height" TargetName="dropDownBorder" Value="95"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter Property="Foreground" Value="#adb5bd"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>

                        <ComboBox Grid.Column="3" Margin="0,0,10,0"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#dee2e6">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter x:Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <TextBlock IsHitTestVisible="False" Text="Método Pago..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#adb5bd">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ToggleButton x:Name="toggleButton" BorderThickness="0" Background="Transparent" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Fill="#6c757d" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Margin="1" PopupAnimation="Slide" Placement="Bottom">
                                            <Border x:Name="dropDownBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="White" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=border}">
                                                <ScrollViewer x:Name="DropDownScrollViewer">
                                                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                        </ComboBox>

                        <CheckBox Grid.Column="4" Content="Ver solo anuladas"
                                  IsChecked="{Binding ShowOnlyCancelled}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,20,0" Foreground="#dc3545" FontWeight="SemiBold"/>

                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <Button Content="🔍 Filtrar" Padding="25,8"
                                    Background="#6c757d" Foreground="White" BorderThickness="0"
                                    Command="{Binding FilterCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="🔄 Ver Todo" Padding="15,8" Margin="10,0,0,0"
                                    Background="White" BorderBrush="#dee2e6" BorderThickness="1"
                                    Command="{Binding ClearFiltersCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sales Table -->
                <Border Background="White" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#f8f9fa" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ticket" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fecha" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Cliente" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Usuario" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="Método" FontWeight="Bold"/>
                                <TextBlock Grid.Column="5" Text="Total" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="Acciones" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- List Items -->
                        <ItemsControl ItemsSource="{Binding FilteredSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#\{0:D5\}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='\{0:dd/MM/yyyy HH:mm\}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CustomerName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SellerName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PaymentMethod}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="C$ " /><Run Text="{Binding Total, StringFormat=N2}" />
                                            </TextBlock>
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="🖨️" ToolTip="Re-imprimir Ticket" Padding="8,2" Background="White" BorderBrush="#dee2e6"
                                                        Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="❌" ToolTip="Anular Venta" Padding="8,2" Background="White" BorderBrush="#dc3545" Foreground="#dc3545" Margin="5,0,0,0"
                                                        Command="{Binding DataContext.CancelSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Botón Cargar Más (Paginación) -->
                        <Button Content="Cargar más registros..."
                                Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding HasMoreItems, Converter={StaticResource VisConverter}}"
                                Margin="20" Padding="15,10"
                                Background="White" BorderBrush="#dee2e6" BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                            </Button.Resources>
                        </Button>

                        <!-- Empty State -->
                        <Grid Margin="40" Visibility="{Binding FilteredSales.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No se han registrado ventas." HorizontalAlignment="Center" Foreground="#adb5bd" FontSize="16"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
