<Window x:Class="POS_v0_1.Views.StockAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajuste de Inventario" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="ProductNameText" Text="Producto: " FontSize="16" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="CurrentStockText" Text="Stock Actual: 0" Foreground="Gray" Margin="0,0,0,20"/>

            <TextBlock Text="Cantidad a ajustar (Ej: +5 entrada, -2 salida):" Margin="0,0,0,5"/>
            <TextBox x:Name="AdjustAmountBox" Padding="8" FontSize="18" Margin="0,0,0,20" FontWeight="Bold" HorizontalContentAlignment="Center"/>

            <TextBlock Text="Motivo del ajuste:" Margin="0,0,0,5"/>
            <TextBox x:Name="ReasonBox" Padding="8" Margin="0,0,0,25" Tag="Ej: Daño, Error de conteo..."/>

            <Button Content="✅ Aplicar Ajuste de Stock" Padding="12" Background="#0d6efd" Foreground="White" FontSize="14" FontWeight="Bold" Click="Apply_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
