<UserControl x:Class="POS_v0_1.Views.CreateFinancialMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Nuevo Movimiento" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Content="← Volver" Padding="15,5"
                            Command="{Binding BackCommand}" Background="White" BorderBrush="#ced4da">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Margin="30" MaxWidth="1000" HorizontalAlignment="Left"
                    BorderBrush="#dee2e6" BorderThickness="1" Padding="30">
                <StackPanel>
                    <TextBlock Text="Registrar Gasto o Ingreso" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TIPO DE MOVIMIENTO *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <Button Content="🔘 Gasto / Salida" Padding="10" Margin="0,0,5,0"
                                        Command="{Binding SetTypeCommand}" CommandParameter="Gasto">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#dc3545"/>
                                            <Setter Property="BorderBrush" Value="#dc3545"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Gasto">
                                                    <Setter Property="Background" Value="#dc3545"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="⊕ Ingreso / Entrada" Padding="10" Margin="5,0,0,0"
                                        Command="{Binding SetTypeCommand}" CommandParameter="Ingreso">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#198754"/>
                                            <Setter Property="BorderBrush" Value="#198754"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Ingreso">
                                                    <Setter Property="Background" Value="#198754"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>

                            <TextBlock Text="Concepto (Descripción Corta) *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Margin="0,0,0,20" Tag="Ej: Pago de luz, Venta externa, etc..."
                                     Text="{Binding Concept, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Fecha del Movimiento *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Date}" Padding="5" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FUENTE / ORIGEN *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                            <ComboBox Padding="10" Margin="0,0,0,20" ItemsSource="{Binding Sources}"
                                      SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Text="Monto (C$) *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Margin="0,0,0,20" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Bold" FontSize="16" TextAlignment="Right"/>

                            <TextBlock Text="Referencia / Comprobante (Opcional)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Margin="0,0,0,20" Tag="Nº Recibo, Factura..."
                                     Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Notas Adicionales" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>

                    <Button Content="💾 Guardar Registro" Background="#0d6efd" Foreground="White" Padding="30,12"
                            FontWeight="Bold" HorizontalAlignment="Right" BorderThickness="0"
                            Command="{Binding SaveCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
