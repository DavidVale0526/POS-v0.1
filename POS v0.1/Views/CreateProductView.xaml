<UserControl x:Class="POS_v0_1.Views.CreateProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1000" Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="White" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title and Back Action -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="← Volver" HorizontalAlignment="Right" Padding="15,8"
                    Background="White" BorderBrush="#ced4da" BorderThickness="1"
                    Command="{Binding BackCommand}">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Información Básica -->
                <TextBlock Text="INFORMACIÓN BÁSICA" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,15">
                            <TextBlock Margin="0,0,0,5"><Run Text="Nombre del Producto"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,15">
                            <TextBlock Margin="0,0,0,5"><Run Text="Categoría"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
                            <TextBlock Text="Proveedor" Margin="0,0,0,5"/>
                            <ComboBox Text="{Binding Provider}" Padding="8" IsEditable="True">
                                <ComboBoxItem Content="Ninguno"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,0">
                            <TextBlock Text="Descripción" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Description}" Padding="8" Height="80" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Códigos y Ubicación -->
                <TextBlock Text="CÓDIGOS Y UBICACIÓN" FontWeight="Bold" Foreground="Gray" Margin="0,10,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Código de Barras 📷" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Barcode}" Padding="8"/>
                            <TextBlock Text="Deje vacío si no tiene." FontSize="10" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="SKU (Código Interno)" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SKU}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ubicación Física" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Location}" Tag="Ej: Estante A, Gaveta 2" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Precios e Inventario -->
                <TextBlock Text="PRECIOS E INVENTARIO" FontWeight="Bold" Foreground="Gray" Margin="0,10,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Margin="0,0,0,5"><Run Text="Precio Compra (C$)"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <TextBox Text="{Binding PurchasePrice}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Margin="0,0,0,5"><Run Text="Precio Venta (C$)"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <TextBox Text="{Binding SellingPrice}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Margin="0,0,0,5"><Run Text="Stock Actual"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <TextBox Text="{Binding Stock}" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Margin="0,0,0,5"><Run Text="Stock Mínimo (Alerta)"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <TextBox Text="{Binding MinStock}" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Opciones Adicionales -->
                <TextBlock Text="OPCIONES ADICIONALES" FontWeight="Bold" Foreground="Gray" Margin="0,10,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Imagen del Producto (Opcional)" Margin="0,0,0,5"/>
                            <DockPanel>
                                <Button Content="Choose File" Padding="10,5" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" Padding="8" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="0,0,0,5"><Run Text="Estado"/><Run Text="*" Foreground="Red"/></TextBlock>
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="💾 Guardar Producto" HorizontalAlignment="Right" Padding="30,12"
                        Background="#007bff" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="Bold"
                        Command="{Binding SaveCommand}" Margin="0,0,0,20">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
