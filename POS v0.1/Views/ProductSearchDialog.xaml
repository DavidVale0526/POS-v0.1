<Window x:Class="POS_v0_1.Views.ProductSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar Producto/Repuesto" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Buscar por nombre o código de barras:" Margin="0,0,0,5"/>
            <TextBox x:Name="SearchBox" Padding="8" TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="ResultsList" DisplayMemberPath="Name"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"/>

        <Button Grid.Row="2" Content="Seleccionar Producto" Margin="0,15,0,0" Padding="10"
                Background="#0d6efd" Foreground="White" FontWeight="Bold" Click="Select_Click"/>
    </Grid>
</Window>
