<UserControl x:Class="POS_v0_1.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e9ecef"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#f8f9fa"/>
                                <Setter Property="BorderBrush" Value="#dee2e6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f8f9fa">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25">
                <!-- Header -->
                <Grid Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Resumen de Hoy" FontSize="24" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="{Binding FormattedDate}"
                                   FontSize="14" Foreground="#666" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Alerta de sesión larga -->
                    <Border Background="#fff3cd" BorderBrush="#ffeeba" BorderThickness="1" CornerRadius="8" Padding="15,8" HorizontalAlignment="Center"
                            Visibility="{Binding ActiveSession.IsTooOld, Converter={StaticResource VisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="La caja lleva abierta más de 24h. Realiza un cierre para evitar descuadros."
                                       FontSize="11" Foreground="#856404" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🛒 Nueva Venta Rápida" HorizontalAlignment="Right"
                            Background="#0d6efd" Foreground="White" Padding="15,10"
                            FontWeight="SemiBold" BorderThickness="0"
                            Command="{Binding NewQuickSaleCommand}">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Summary Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,30">
                    <!-- Ventas -->
                    <Border Background="White" Margin="0,0,15,0" Padding="20" CornerRadius="8" BorderThickness="4,0,0,0" BorderBrush="#198754">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="VENTAS (HOY)" FontSize="12" FontWeight="Bold" Foreground="#666"/>
                                <TextBlock FontWeight="Bold" FontSize="22" Foreground="#333" Margin="0,15,0,0">
                                    <Run Text="C$ " /><Run Text="{Binding TodaySales, Mode=OneWay, StringFormat=N2}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Width="40" Height="40" Background="#e8f5e9" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="🛒" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Recargas -->
                    <Border Background="White" Margin="0,0,15,0" Padding="20" CornerRadius="8" BorderThickness="4,0,0,0" BorderBrush="#0d6efd">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="RECARGAS (HOY)" FontSize="12" FontWeight="Bold" Foreground="#666"/>
                                <TextBlock FontWeight="Bold" FontSize="22" Foreground="#333" Margin="0,15,0,0">
                                    <Run Text="C$ " /><Run Text="{Binding TodayTopups, Mode=OneWay, StringFormat=N2}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Width="40" Height="40" Background="#e7f1ff" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="📱" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Reparaciones -->
                    <Border Background="White" Margin="0,0,15,0" Padding="20" CornerRadius="8" BorderThickness="4,0,0,0" BorderBrush="#ffc107">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="REP. PENDIENTES" FontSize="12" FontWeight="Bold" Foreground="#666"/>
                                <TextBlock Text="{Binding PendingRepairs, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="#333" Margin="0,15,0,0"/>
                            </StackPanel>
                            <Border Width="40" Height="40" Background="#fffcf0" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="🛠️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Stock Bajo -->
                    <Border Background="White" Padding="20" CornerRadius="8" BorderThickness="4,0,0,0" BorderBrush="#dc3545">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/></Border.Effect>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="STOCK BAJO" FontSize="12" FontWeight="Bold" Foreground="#666"/>
                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <TextBlock Text="{Binding LowStockProducts, Mode=OneWay}" FontWeight="Bold" FontSize="22" Foreground="#333"/>
                                    <TextBlock Text=" productos" FontSize="14" Foreground="#666" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Width="40" Height="40" Background="#fff5f5" CornerRadius="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="⚠️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Sales Table -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,20,0" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="ÚLTIMAS VENTAS" FontWeight="Bold" Foreground="#444"/>
                                <Button Content="Ver Todas" HorizontalAlignment="Right" Background="Transparent" BorderBrush="#dee2e6" BorderThickness="1" Padding="10,4" Foreground="#666" Command="{Binding ViewAllSalesCommand}"/>
                            </Grid>

                            <Border Background="#f8f9fa" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ticket" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBlock Grid.Column="1" Text="Hora" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBlock Grid.Column="2" Text="Vendedor" FontWeight="SemiBold" Foreground="#666"/>
                                    <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" Foreground="#666" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#f1f3f5" BorderThickness="0,0,0,1" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Id, StringFormat='#\{0:D5\}'}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat='\{0:HH:mm\}'}" Foreground="#666" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SellerName}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Run Text="C$ " /><Run Text="{Binding Total, StringFormat=N2}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,40" Visibility="{Binding RecentSales.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="No hay ventas registradas hoy." HorizontalAlignment="Center" Foreground="#adb5bd" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ACCESOS RÁPIDOS" FontWeight="Bold" Foreground="#444" Margin="0,0,0,15"/>

                        <Button Style="{StaticResource QuickActionButton}" Command="{Binding RegisterProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊕" FontSize="18" Foreground="#0d6efd" Margin="0,0,15,0"/>
                                <TextBlock Text="Registrar Producto" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickActionButton}" Command="{Binding NewTopupCommand}" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📱" FontSize="18" Foreground="#0d6efd" Margin="0,0,15,0"/>
                                <TextBlock Text="Nueva Recarga" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickActionButton}" Command="{Binding NewRepairCommand}" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛠️" FontSize="18" Foreground="#ffc107" Margin="0,0,15,0"/>
                                <TextBlock Text="Orden de Reparación" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource QuickActionButton}" Command="{Binding CashControlCommand}" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="18" Foreground="#198754" Margin="0,0,15,0"/>
                                <TextBlock Text="Abrir/Cerrar Caja" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
