<UserControl x:Class="POS_v0_1.Views.NewBankTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="Nueva Transacción Bancaria" FontSize="20" FontWeight="Bold"/>
                <Button Content="← Volver" HorizontalAlignment="Right" Padding="15,5"
                        Command="{Binding BackCommand}" Background="White" BorderBrush="#ced4da"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Margin="30,10" MaxWidth="600" HorizontalAlignment="Center"
                    BorderBrush="#dee2e6" BorderThickness="1" Padding="30">
                <StackPanel>
                    <TextBlock Text="Registrar Transacción Bancaria" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,25"/>

                    <TextBlock Text="{Binding CurrentBalance, StringFormat='SALDO ACTUAL: C$ \{0:N2\}'}"
                               HorizontalAlignment="Center" Foreground="#0d6efd" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Transaction Type Toggle -->
                    <TextBlock Text="TIPO DE TRANSACCIÓN *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                    <Grid Height="40" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="☺ Depósito (+)"
                                Command="{Binding SetTypeCommand}" CommandParameter="Depósito">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#198754"/>
                                    <Setter Property="BorderBrush" Value="#ced4da"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1,1,0,1" CornerRadius="4,0,0,4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Depósito">
                                            <Setter Property="Background" Value="#198754"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#198754"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Grid.Column="1" Content="☹ Retiro (-)"
                                Command="{Binding SetTypeCommand}" CommandParameter="Retiro">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#dc3545"/>
                                    <Setter Property="BorderBrush" Value="#ced4da"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="0,4,4,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Retiro">
                                            <Setter Property="Background" Value="#dc3545"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#dc3545"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Amount -->
                    <TextBlock Text="Monto (C$) *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" FontSize="16" Margin="0,0,0,20"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N2\}}"/>

                    <!-- Bank and Date Row -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Banco *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox Padding="10" Text="{Binding Bank, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fecha *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding Date}" Padding="5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Reference -->
                    <TextBlock Text="Referencia / Comprobante" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Margin="0,0,0,20" Tag="No. de recibo, transferencia..."
                             Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Notes -->
                    <TextBlock Text="Notas Adicionales" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox Padding="10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,30"/>

                    <!-- Action Button -->
                    <Button Content="💾 Guardar Transacción" Background="#0d6efd" Foreground="White" Padding="30,12"
                            FontWeight="Bold" HorizontalAlignment="Stretch" BorderThickness="0"
                            Command="{Binding SaveCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
