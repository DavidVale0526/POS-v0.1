<UserControl x:Class="POS_v0_1.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="#f8f9fa" CornerRadius="8" Margin="0,0,0,20">
            <Grid>
                <TextBlock Text="Compras a Proveedores" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Historial Header -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Historial de Compras" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

            <TextBox Grid.Column="1" Padding="8" VerticalContentAlignment="Center"
                     Tag="Buscar por proveedor o factura..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Grid.Column="2" Content="🛒 Registrar Compra" HorizontalAlignment="Right" Padding="15,8"
                    Background="#007bff" Foreground="White" BorderThickness="0"
                    Command="{Binding ShowCreatePurchaseCommand}">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Purchases}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="1" BorderBrush="#dee2e6"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#eee" HeadersVisibility="Column" RowHeight="45">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#f8f9fa"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,10"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#dee2e6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Provider.Name}" Width="*"/>
                <DataGridTextColumn Header="Factura" Binding="{Binding InvoiceNumber}" Width="150"/>
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Recibida">
                                                <Setter Property="Background" Value="#d1e7dd"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Pendiente">
                                                <Setter Property="Background" Value="#fff3cd"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Parcial">
                                                <Setter Property="Background" Value="#cfe2ff"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Recibida">
                                                    <Setter Property="Foreground" Value="#0f5132"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pendiente">
                                                    <Setter Property="Foreground" Value="#664d03"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Parcial">
                                                    <Setter Property="Foreground" Value="#084298"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="120"/>
                <DataGridTextColumn Header="Registrado por" Binding="{Binding RegisteredBy}" Width="150"/>
                <DataGridTemplateColumn Header="Acciones" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="👁" Padding="5,2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.ShowPurchaseDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✏️" Padding="5,2" Background="Transparent" BorderThickness="0" Margin="5,0,0,0"
                                        Command="{Binding DataContext.ShowEditPurchaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
