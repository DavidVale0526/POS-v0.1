<UserControl x:Class="POS_v0_1.Views.RepairListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Reparaciones" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Title and New Repair Button -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Control de Reparaciones" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <Button Content="🔧 Nueva Reparación" HorizontalAlignment="Right"
                            Background="#0d6efd" Foreground="White" Padding="15,8"
                            BorderThickness="0" FontWeight="SemiBold"
                            Command="{Binding ShowCreateRepairCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Filters -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#dee2e6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,10,0" Padding="10,8"
                                 Tag="Buscar Nº Orden, cliente, teléfono o modelo..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="#dee2e6"/>
                        <ComboBox Grid.Column="1" Margin="0,0,10,0"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  VerticalContentAlignment="Center" BorderBrush="#dee2e6"/>
                        <Button Grid.Column="2" Content="🔍 Buscar" Padding="40,8"
                                Background="#6c757d" Foreground="White" BorderThickness="0"
                                Command="{Binding FilterCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Repairs Table -->
                <Border Background="White" CornerRadius="8" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#f8f9fa" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Orden" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fecha Ingreso" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Cliente" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Dispositivo" FontWeight="Bold"/>
                                <TextBlock Grid.Column="4" Text="Falla Reportada" FontWeight="Bold"/>
                                <TextBlock Grid.Column="5" Text="Estado" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="Total" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="Acciones" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- List Items -->
                        <ItemsControl ItemsSource="{Binding FilteredRepairs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EntryDate, StringFormat='\{0:dd/MM/yyyy HH:mm\}'}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ClientName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center">
                                                <Run Text="{Binding DeviceBrand}"/> <Run Text="{Binding DeviceModel}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding ReportedFailure}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                            <Border Grid.Column="5" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#e9ecef"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Recibido">
                                                                <Setter Property="Background" Value="#fff3cd"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Entregado">
                                                                <Setter Property="Background" Value="#d1e7dd"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#495057"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Recibido">
                                                                    <Setter Property="Foreground" Value="#856404"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Entregado">
                                                                    <Setter Property="Foreground" Value="#0f5132"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding Total, StringFormat='C$ \{0:N2\}'}"/>

                                            <Button Grid.Column="7" Content="Entregar" Padding="10,2" Background="White" BorderBrush="#28a745" Foreground="#28a745"
                                                    Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Entregado">
                                                                <Setter Property="Content" Value="Reabrir"/>
                                                                <Setter Property="BorderBrush" Value="#6c757d"/>
                                                                <Setter Property="Foreground" Value="#6c757d"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <Grid Margin="40" Visibility="{Binding FilteredRepairs.Count, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No se han registrado órdenes de reparación." HorizontalAlignment="Center" Foreground="#adb5bd" FontSize="16"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
