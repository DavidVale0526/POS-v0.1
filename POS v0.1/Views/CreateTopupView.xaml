<UserControl x:Class="POS_v0_1.Views.CreateTopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Nueva Recarga" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox Width="150" SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Registrar Recarga" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <Button Content="← Volver" HorizontalAlignment="Right"
                            Padding="15,5" Background="White" BorderBrush="#ced4da"
                            Command="{Binding BackCommand}"/>
                </Grid>

                <Border Background="White" CornerRadius="8" Padding="30" Width="450" HorizontalAlignment="Center"
                        BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <!-- Company Selection -->
                        <TextBlock Text="Compañía" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="TIGO" Margin="0,0,5,0" Height="45"
                                    Command="{Binding SelectTigoCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#004a99"/>
                                        <Setter Property="BorderBrush" Value="#004a99"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCompany}" Value="TIGO">
                                                <Setter Property="Background" Value="#e7f1ff"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="1" Content="CLARO" Margin="5,0,0,0" Height="45"
                                    Command="{Binding SelectClaroCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#dc3545"/>
                                        <Setter Property="BorderBrush" Value="#dc3545"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCompany}" Value="CLARO">
                                                <Setter Property="Background" Value="#f8d7da"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Phone Number -->
                        <TextBlock Text="Número de Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20" Padding="10" TextAlignment="Center" FontWeight="Bold"
                                 Margin="0,0,0,20" BorderBrush="#80bdff" BorderThickness="2"/>

                        <!-- Amount and Cost -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="MONTO VENDIDO (C$)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="10" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="COSTO (C$)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Padding="10" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="Notas (Opcional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10" Tag="Referencia de la transacción" Margin="0,0,0,25"/>

                        <!-- Confirm Button -->
                        <Button Content="✓ Confirmar Recarga" Height="50" Background="#198754" Foreground="White"
                                FontSize="16" FontWeight="Bold" BorderThickness="0"
                                Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
