<UserControl x:Class="POS_v0_1.Views.CreateTopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="Nueva Recarga" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Registrar Recarga" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <Button Content="← Volver" HorizontalAlignment="Right"
                            Padding="15,5" Background="White" BorderBrush="#ced4da"
                            Command="{Binding BackCommand}"/>
                </Grid>

                <Border Background="White" CornerRadius="8" Padding="30" Width="450" HorizontalAlignment="Center"
                        BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <!-- Company Selection -->
                        <TextBlock Text="Compañía" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Companies}"
                                 SelectedItem="{Binding SelectedCompany}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" Background="White" BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="5" Margin="5" Height="45">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding Color}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Phone Number -->
                        <TextBlock Text="Número de Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20" Padding="10" TextAlignment="Center" FontWeight="Bold"
                                 Margin="0,0,0,20" BorderBrush="#80bdff" BorderThickness="2"/>

                        <!-- Presets Section -->
                        <TextBlock Text="Recargas Rápidas" FontWeight="SemiBold" Margin="0,0,0,5"
                                   Visibility="{Binding FilteredPresets.Count, Converter={StaticResource VisConverter}}"/>
                        <ItemsControl ItemsSource="{Binding FilteredPresets}" Margin="0,0,0,20">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Amount, StringFormat='C$ {0:N0}'}"
                                            Margin="5" Padding="15,8" Background="White" BorderBrush="#dee2e6"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="20">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#f8f9fa"/>
                                                        <Setter Property="BorderBrush" Value="#0d6efd"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Amount and Cost -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="MONTO VENDIDO (C$)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="10" TextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="COSTO (C$)" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" Padding="10" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="Notas (Opcional)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10" Tag="Referencia de la transacción" Margin="0,0,0,25"/>

                        <!-- Confirm Button -->
                        <Button Content="✓ Confirmar Recarga" Height="50" Background="#198754" Foreground="White"
                                FontSize="16" FontWeight="Bold" BorderThickness="0"
                                Command="{Binding SaveCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
