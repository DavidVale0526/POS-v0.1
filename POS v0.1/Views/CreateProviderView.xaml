<UserControl x:Class="POS_v0_1.Views.CreateProviderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:POS_v0_1.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="White" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#EEEEEE"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title and Back Action -->
        <Grid Grid.Row="1" Margin="0,0,0,15" Visibility="Collapsed"> <!-- Hidden as it's now in header, but keeping Grid for Row index consistency if needed -->
        </Grid>

        <!-- Re-adjusting the content to follow the header -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <Button Content="← Volver a Proveedores" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0" Foreground="#007bff"
                    Command="{Binding BackCommand}" Cursor="Hand"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Nombre de la Empresa *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" Padding="10,8"/>

                    <TextBlock Text="Nombre del Contacto" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ContactName}" Margin="0,0,0,15" Padding="10,8"/>

                    <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Phone}" Margin="0,0,0,15" Padding="10,8"/>

                    <TextBlock Text="Correo Electrónico" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email}" Margin="0,0,0,15" Padding="10,8"/>
                </StackPanel>

                <!-- Right Column -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Ciudad" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding City}" Margin="0,0,0,15" Padding="10,8"/>

                    <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Address}" Margin="0,0,0,15" Padding="10,8"/>

                    <TextBlock Text="Descripción / Notas" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Description}" Height="118" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#eee" Padding="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Margin="10,0" Padding="20,10" Background="#f8f9fa"
                        Command="{Binding BackCommand}"/>
                <Button Content="Guardar Proveedor" Padding="20,10" Background="#28a745" Foreground="White"
                        BorderThickness="0" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
