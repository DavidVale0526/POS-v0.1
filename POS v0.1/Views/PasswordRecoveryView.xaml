<UserControl x:Class="POS_v0_1.Views.PasswordRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="#f0f2f5">
        <Border Background="White" CornerRadius="15" Padding="40" MaxWidth="450" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#CCCCCC" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Recuperar Acceso" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Paso 1: Email -->
                <StackPanel Visibility="{Binding Step1Visible, Converter={StaticResource VisConverter}}">
                    <TextBlock Text="Ingresa tu correo electrónico registrado:" Margin="0,0,0,10" Foreground="#666"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="12" Margin="0,0,0,20" BorderBrush="#dee2e6"/>

                    <Button Content="Continuar" Background="#0d6efd" Foreground="White" Padding="15" FontWeight="Bold" Command="{Binding CheckEmailCommand}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Paso 2: Preguntas -->
                <StackPanel Visibility="{Binding Step2Visible, Converter={StaticResource VisConverter}}">
                    <TextBlock Text="Responde a las preguntas de seguridad:" Margin="0,0,0,20" Foreground="#666" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding Question1}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Answer1, UpdateSourceTrigger=PropertyChanged}" Padding="12" Margin="0,0,0,15" BorderBrush="#dee2e6"/>

                    <TextBlock Text="{Binding Question2}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Answer2, UpdateSourceTrigger=PropertyChanged}" Padding="12" Margin="0,0,0,25" BorderBrush="#dee2e6"/>

                    <Button Content="Verificar Respuestas" Background="#198754" Foreground="White" Padding="15" FontWeight="Bold" Command="{Binding VerifyAnswersCommand}">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Paso 3: Nueva Clave -->
                <StackPanel Visibility="{Binding Step3Visible, Converter={StaticResource VisConverter}}">
                    <TextBlock Text="¡Identidad Verificada!" Foreground="#198754" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Ingresa tu nueva contraseña:" Margin="0,0,0,15" Foreground="#666"/>

                    <PasswordBox x:Name="PassBox" Padding="12" Margin="0,0,0,25" BorderBrush="#dee2e6"/>

                    <Button Content="Actualizar Contraseña" Background="#0d6efd" Foreground="White" Padding="15" FontWeight="Bold"
                            Command="{Binding ResetPasswordCommand}" Click="Button_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>

                <Button Content="Volver al Login" Background="Transparent" BorderThickness="0" Foreground="Gray"
                        Margin="0,20,0,0" Cursor="Hand" Command="{Binding BackCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
