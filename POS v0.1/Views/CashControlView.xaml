<UserControl x:Class="POS_v0_1.Views.CashControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="15" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Control de Caja" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#e9ecef" CornerRadius="15" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="Gray" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Session.OpenedBy, TargetNullValue='Sin Usuario'}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20">
                <TextBlock Text="Control de Caja" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Current Session Card -->
                <Border Background="White" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="8" Width="350" HorizontalAlignment="Left"
                        Visibility="{Binding Session.IsOpen, Converter={StaticResource VisConverter}}">
                    <StackPanel>
                        <!-- Header Verde -->
                        <Border Background="#198754" CornerRadius="8,8,0,0" Padding="15,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,10,0" Foreground="White"/>
                                <TextBlock Text="Caja Actual (Abierta)" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Alerta de sesión larga -->
                        <Border Background="#fff3cd" BorderBrush="#ffeeba" BorderThickness="0,0,0,1" Padding="15,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.IsTooOld}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Esta caja lleva abierta más de 24h. Se recomienda cerrarla para auditar correctamente."
                                           FontSize="10" Foreground="#856404" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="20">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Abierta por:" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="{Binding Session.OpenedBy}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="Fecha Apertura:" Foreground="Gray" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Session.OpeningTime, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </Grid>

                            <Separator Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Fondo Inicial:" Foreground="Gray"/>
                                <TextBlock Grid.Column="1" Text="{Binding Session.OpeningBalance, StringFormat='C$ {0:N2}'}" Foreground="#0d6efd" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Text="Ventas / Ingresos (+):" Foreground="Gray" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Session.SalesTotal, StringFormat='C$ {0:N2}'}" Foreground="#198754" FontWeight="Bold" Margin="0,5,0,0"/>

                                <!-- Desglose de Métodos -->
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="15,5,0,10">
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="• Efectivo:" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding Session.CashTotal, StringFormat='C$ {0:N2}'}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="• Tarjeta:" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding Session.CardTotal, StringFormat='C$ {0:N2}'}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="• Transferencia:" FontSize="11" Foreground="#666"/>
                                        <TextBlock Text="{Binding Session.TransferTotal, StringFormat='C$ {0:N2}'}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Text="Gastos (-):" Foreground="Gray" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Session.ExpensesTotal, StringFormat='C$ {0:N2}'}" Foreground="#dc3545" FontWeight="Bold" Margin="0,5,0,0"/>
                            </Grid>

                            <Border Background="#f8f9fa" Margin="0,20,0,20" Padding="15,10" CornerRadius="5">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Saldo Teórico:" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Session.TheoreticalBalance, StringFormat='C$ {0:N2}'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,5,0,0">
                                        <TextBlock Text="Efectivo Contado:" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Session.ClosingBalance, StringFormat='C$ {0:N2}'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="#198754"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,5,0,0">
                                        <TextBlock Text="Diferencia:" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Session.Difference, StringFormat='C$ {0:N2}'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="{Binding Session.Difference, Converter={StaticResource DifferenceToBrushConverter}}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Button Content="🔒 Cerrar Caja" Command="{Binding CloseCommand}"
                                    Background="#dc3545" Style="{StaticResource RoundedButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Open Box Form -->
                <Border Background="White" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="8" Width="350" HorizontalAlignment="Left"
                        Visibility="{Binding Session.IsOpen, Converter={StaticResource VisConverter}, ConverterParameter=Inverse}">
                    <StackPanel Margin="20">
                        <TextBlock Text="Abrir Nueva Caja" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock Text="Fondo Inicial (Monto en efectivo):" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding OpeningAmount, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,20"/>
                        <Button Content="Abrir Caja" Command="{Binding OpenCommand}"
                                Background="#0d6efd" Style="{StaticResource RoundedButtonStyle}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Historial de Cajas" FontSize="18" FontWeight="Bold" Margin="0,30,0,15"/>

                <Border Background="White" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="5">
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="None" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding OpenedBy}" Width="*"/>
                            <DataGridTextColumn Header="Apertura" Binding="{Binding OpeningTime, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" Width="*"/>
                            <DataGridTextColumn Header="Cierre" Binding="{Binding ClosingTime, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}" Width="*"/>
                            <DataGridTextColumn Header="Inicial" Binding="{Binding OpeningBalance, StringFormat='C$ {0:N2}'}" Width="Auto"/>
                            <DataGridTextColumn Header="Final" Binding="{Binding ClosingBalance, StringFormat='C$ {0:N2}'}" Width="Auto"/>
                            <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference, StringFormat='C$ {0:N2}'}" Width="Auto"/>
                            <DataGridTemplateColumn Header="Estado" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsOpen, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="10" Padding="10,2" Margin="5">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Acciones" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
