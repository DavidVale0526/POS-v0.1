<UserControl x:Class="POS_v0_1.Views.CreatePurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="15" Background="#f8f9fa" CornerRadius="8" Margin="0,0,0,20">
            <Grid>
                <TextBlock Text="Registrar Compra" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding DataContext.SwitchUserCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#e7f1ff" CornerRadius="15" Padding="10,4" BorderBrush="#0d6efd" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤 " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.CurrentUser.Name, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#0d6efd"/>
                                    <TextBlock Text=" (Cambiar)" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title and Back Action -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Registrar Nueva Compra" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="← Cancelar" HorizontalAlignment="Right" Padding="15,8"
                    Background="White" BorderBrush="#ced4da" BorderThickness="1"
                    Command="{Binding BackCommand}">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Form Fields -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Proveedor *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProvider}" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Número de Factura" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding InvoiceNumber}" Tag="Opcional" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Fecha de Compra *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding PurchaseDate}" Padding="10,8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Productos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Product Search -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Buscar Producto" FontSize="12" Foreground="Gray"/>
                        <ComboBox ItemsSource="{Binding Products}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedProductToSearch}"
                                  IsEditable="True" Padding="10,8"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="+" Margin="10,16,5,0" Padding="10,0"
                            Background="White" BorderBrush="#007bff" Foreground="#007bff"
                            Command="{Binding ShowQuickCreateProductCommand}"/>

                    <Button Grid.Column="2" Content="+ Agregar" Margin="5,16,0,0" Padding="25,8"
                            Background="#6c757d" Foreground="White" BorderThickness="0"
                            Command="{Binding AddItemCommand}">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Items Grid -->
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="200"
                          RowHeight="40" Background="White" BorderBrush="#dee2e6" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="Precio Unitario (C$)" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Notas Adicionales" FontWeight="SemiBold" Margin="0,20,0,5"/>
                <TextBox Text="{Binding Notes}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,8" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="0,15,0,0" BorderThickness="0,1,0,0" BorderBrush="#eee">
            <Grid>
                <StackPanel Orientation="Horizontal">
                     <TextBlock Text="Total Compra: " FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                     <TextBlock Text="{Binding Total, StringFormat=C2}" FontSize="18" FontWeight="Bold" Foreground="#007bff" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="💾 Guardar Compra" HorizontalAlignment="Right" Padding="25,10"
                        Background="#007bff" Foreground="White" BorderThickness="0"
                        Command="{Binding SavePurchaseCommand}">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
